{"aggregate_id": "01M491G6102N7NRMAW3219Z2F9", "aggregate_type": "Mission", "event_id": "01M491GAX64XAP2HV8JE7K7MJV", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-06T16:42:12.930421+00:00", "friendly_name": "Charter offering, activation presets and the doctrine-to-charter cutover", "mission_id": "01M491G6102N7NRMAW3219Z2F9", "mission_number": null, "mission_slug": "charter-pack-cutover-01M491G6", "mission_type": "software-dev", "purpose_context": "Earlier renames kept old names working, leaving two names for one thing: agents and contributors get confused and users' harnesses contradict themselves. Following ADR 2026-10-06-1, a Charter Pack becomes a bundle of charter components plus activation presets applied with charter activate --pack/--preset, the doctrine command group and skill names are cut over in one step, and one upgrade migration rewrites existing projects so nothing silently loses activated artifacts.", "purpose_tldr": "Replace the retired doctrine-pack vocabulary with one charter vocabulary across CLI, config, skills, code and docs, with activation presets as pack data and no compatibility layer.", "target_branch": "issue-3732-charter-pack-rename", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-06T16:42:16.358559+00:00"}
